# ---------------------------------------------------------------------------
# Sahaj Shiksha — environment configuration
# Copy to `.env` (apps read it from the repo root or their own folder).
# Everything here is OPTIONAL: with an empty file the platform runs fully
# offline using the deterministic local fallbacks in packages/ai.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
# Comma-separated allowlist for browser calls. Government school proxies are
# often strict, so keep this explicit rather than "*" in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Baked into the web build (Next.js inlines NEXT_PUBLIC_* at build time).
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Database (Module 5: progress + analytics) -----------------------------
DATABASE_URL=postgresql://sahaj:sahaj@localhost:5432/sahaj
# Session store + audio cache (Module 2/4)
REDIS_URL=redis://localhost:6379
# Audio / visual asset store (S3-compatible: MinIO on-prem for schools)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sahaj-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI / NLP providers (Module 2) ----------------------------------------
# AI_PROVIDER=local | openai | custom
#   local  (default) rule-based simplification on the server + browser Web
#          Speech APIs. Works with zero connectivity and no API key.
#   openai           hosted OpenAI.
#   custom           any OpenAI-compatible endpoint: self-hosted vLLM, Text
#                    Generation Inference (HuggingFace models), Ollama, LM Studio,
#                    Azure OpenAI gateways. Point OPENAI_BASE_URL at it.
# When a key is missing, or the provider fails, the server falls back to the
# local engine and marks the result `degraded` rather than returning an error.
AI_PROVIDER=local
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_RETRIES=2

# Required for openai/custom. For most self-hosted servers any non-empty value
# works, because they do not check it.
OPENAI_API_KEY=
# Self-hosted example: http://gpu-box.local:8000/v1
OPENAI_BASE_URL=
OPENAI_SIMPLIFY_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1

# --- Feature flags ---------------------------------------------------------
# Analytics/telemetry must never leak a child's identity. Off by default.
ENABLE_TELEMETRY=false
# Force every request through the offline code path (useful for testing).
FORCE_OFFLINE_MODE=false
